# Configure values in a private .env (mode 0600), never in Git.
# scripts/configure-local.py creates a runnable local configuration with generated DB credentials.
# Production: list actual public DNS names in SITE_ADDRESSES to activate automatic TLS.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
TENANTS_JSON=
SITE_ADDRESSES=
HEALTH_HOST=
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
STUDIO_OPENAI_API_KEY=
TURNSTILE_SECRET=
PROVIDER_ENABLED=false
BUDGET_APPROVED=false
GLOBAL_KILL_SWITCH=true
GLOBAL_BUDGET_CENTS=500
ALLOW_LOCAL_HTTP=false
HARD_LIMIT_VERIFIED_AT=
HANDOFF_AUTH_MEIN_KUECHENEXPERTE=
HANDOFF_AUTH_ISOLATION_CHECK=

# Optional explicit HMAC key; otherwise generated privately in shared DATA_DIR.
RATE_LIMIT_SECRET=

# Optional verified contract; empty preserves conservative reservation ceilings.
VERIFIED_PRICING_FILE=
VERIFIED_PRICING_SHA256=
