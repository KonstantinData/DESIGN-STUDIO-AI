{
  http_port 8080
  https_port 8443
  admin off
  servers {
    timeouts {
      read_header 10s
      read_body 20s
      idle 120s
    }
  }
}
{$SITE_ADDRESSES} {
  basic_auth {
    {$STUDIO_REVIEW_USERNAME} {$STUDIO_REVIEW_PASSWORD_HASH}
  }
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    -Server
  }
  handle /api/* {
    request_body {
      max_size 13631488
    }
    header Cache-Control "no-store"
    reverse_proxy backend:8000 {
      header_up Host {hostport}
      header_up X-Forwarded-For {remote_host}
      header_up -Forwarded
      header_up -X-Real-IP
    }
  }
  handle /healthz {
    reverse_proxy backend:8000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}

:8090 {
  handle /healthz {
    reverse_proxy backend:8000
  }
  respond 404
}

http://:8080 {
  respond "Unbekannter Host." 421
}
